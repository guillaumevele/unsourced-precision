smoke_logs/

.DS_Store
data/private/

# Sorties de relance de l annotation (diagnostic, pas des journaux de run)
logs/*.last.txt

# Sauvegardes laissées par ots upgrade
timestamps/*.ots.bak
.venv-pilot/
